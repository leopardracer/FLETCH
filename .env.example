# --- Robinhood Chain ---
CHAIN_ID=4663
# No default baked in on purpose — public endpoint is rate-limited and
# unsuitable for production. See https://docs.robinhood.com/chain/
# Free dev default: https://rpc.mainnet.chain.robinhood.com
RPC_URL=

# --- Blockscout (official Robinhood Chain explorer) ---
# Free tier key from https://dev.blockscout.com — used to accelerate
# holder counts / tx lists instead of raw log replay. Optional: FLETCH
# falls back to raw RPC log scanning if unset (slower, works from block
# 0 on request but no free lifetime cross-token holder index).
BLOCKSCOUT_API_KEY=
BLOCKSCOUT_API_BASE=https://api.blockscout.com

# --- Optional: USD conversion for ETH-denominated pairs ---
PAIR_ASSET_COINGECKO_ID=ethereum

# --- Discovery / scan window ---
# How many blocks back `getNewTokens` scans when no cursor is given.
SIGNAL_WINDOW_BLOCKS=50000
WHALE_THRESHOLD_TOKENS=1000000

# --- API server ---
PORT=8787

# --- Persistence (Phase 2) ---
# Node's built-in node:sqlite — no separate database server to run. The
# file is created automatically on first write; safe to delete to reset
# all history (snapshots, signals, wallet activity).
DB_PATH=./fletch.db

# --- Background poller (Phase 2 signal engine) ---
# Without this, snapshots/signals only accumulate when someone opens a
# token page. The poller snapshots the most recent launches on an
# interval so trend signals (holder growth, liquidity change, activity
# acceleration) exist continuously. Only starts if RPC_URL is set.
ENABLE_POLLER=true
POLL_INTERVAL_MS=300000
POLL_TOKEN_LIMIT=15
# Minimum seconds between two recorded snapshots for the same token —
# prevents rapid page views (or a poll tick landing right after one) from
# writing near-duplicate rows.
SNAPSHOT_MIN_INTERVAL_SECONDS=60

# --- Continuous monitoring (docs/MONITORING.md) ---
# How often the bounded launch-discovery scan runs and adds new tokens to
# the monitoring queue. Also when the retention prune runs.
DISCOVERY_INTERVAL_MS=300000
# In-flight chain reads per monitoring cycle, regardless of queue size —
# the real bound on RPC load. Keep this low against a shared/public RPC.
MAX_CONCURRENT_TOKENS=5
# Hard cap on the monitoring queue itself — bounds storage and RPC load
# even if launches vastly outpace check capacity.
MAX_MONITORED_TOKENS=500
# A token failing this many checks in a row is marked FAILED and stops
# being scheduled — stops one permanently-broken address from retrying
# forever.
MAX_CONSECUTIVE_FAILURES=5
# How long signal/snapshot history is kept before the retention prune
# deletes it.
SIGNAL_RETENTION_DAYS=30
SNAPSHOT_RETENTION_DAYS=30
