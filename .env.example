# --- Robinhood Chain ---
CHAIN_ID=4663
# No default baked in on purpose — public endpoint is rate-limited and
# unsuitable for production. See https://docs.robinhood.com/chain/
# Free dev default: https://rpc.mainnet.chain.robinhood.com
RPC_URL=

# --- Blockscout (official Robinhood Chain explorer) ---
# Free tier key from https://dev.blockscout.com — used to accelerate
# holder counts / tx lists instead of raw log replay. Optional: FLETCH
# falls back to raw RPC log scanning if unset (slower, works from block
# 0 on request but no free lifetime cross-token holder index).
BLOCKSCOUT_API_KEY=
BLOCKSCOUT_API_BASE=https://api.blockscout.com

# --- Optional: USD conversion for ETH-denominated pairs ---
PAIR_ASSET_COINGECKO_ID=ethereum

# --- Discovery / scan window ---
# How many blocks back `getNewTokens` scans when no cursor is given.
SIGNAL_WINDOW_BLOCKS=50000
WHALE_THRESHOLD_TOKENS=1000000

# --- API server ---
PORT=8787
# Set to 1 behind a hosting proxy (Railway, Fly, nginx) so rate limits are per visitor.
TRUST_PROXY=0

# --- Persistence (Phase 2) ---
# Node's built-in node:sqlite — no separate database server to run. The
# file is created automatically on first write; safe to delete to reset
# all history (snapshots, signals, wallet activity).
DB_PATH=./fletch.db

# --- Background poller (Phase 2 signal engine) ---
# Without this, snapshots/signals only accumulate when someone opens a
# token page. The poller snapshots the most recent launches on an
# interval so trend signals (holder growth, liquidity change, activity
# acceleration) exist continuously. Only starts if RPC_URL is set.
ENABLE_POLLER=true
POLL_INTERVAL_MS=300000
POLL_TOKEN_LIMIT=15
# Minimum seconds between two recorded snapshots for the same token —
# prevents rapid page views (or a poll tick landing right after one) from
# writing near-duplicate rows.
SNAPSHOT_MIN_INTERVAL_SECONDS=60

# --- Continuous monitoring (docs/MONITORING.md) ---
# How often the bounded launch-discovery scan runs and adds new tokens to
# the monitoring queue. Also when the retention prune runs.
DISCOVERY_INTERVAL_MS=300000
# How often every watched curve is checked for new trades in one batched
# eth_getLogs (≤100 curves per call). A trade makes that token HIGH and due
# now; launches with no trade after 15 min drop to LOW. docs/MONITORING.md
ACTIVITY_SWEEP_INTERVAL_MS=60000
# In-flight chain reads per monitoring cycle, regardless of queue size —
# the real bound on RPC load. Keep this low against a shared/public RPC.
MAX_CONCURRENT_TOKENS=5
# Hard cap on the monitoring queue itself — bounds storage and RPC load
# even if launches vastly outpace check capacity.
MAX_MONITORED_TOKENS=500
# A token failing this many checks in a row is marked FAILED and stops
# being scheduled — stops one permanently-broken address from retrying
# forever.
MAX_CONSECUTIVE_FAILURES=5
# A FAILED token gets a fresh set of retries after this cool-off (seconds)
# instead of staying dead until a restart. 0 disables reactivation.
FAILED_REACTIVATE_AFTER_SECONDS=21600
# How long signal/snapshot history is kept before the retention prune
# deletes it.
SIGNAL_RETENTION_DAYS=30
SNAPSHOT_RETENTION_DAYS=30

# --- RPC rate-limit backoff (core/rpcBackoff.ts) ---
# When the provider answers 429 / "daily request limit", the poller stops
# all chain reads for a while instead of firing a full batch every cycle.
# Rate-limited checks never count against a token's failure count.
# First pause, doubling on each consecutive rate limit:
RPC_BACKOFF_BASE_MS=60000
# Ceiling — a daily-quota error goes straight here:
RPC_BACKOFF_MAX_MS=3600000

# --- Optional: Multicall3 (chain/client.ts) ---
# If a Multicall3 contract is deployed on this chain, set its address to
# aggregate concurrent contract reads into one eth_call. Verify first:
#   curl -s -X POST $RPC_URL -H 'content-type: application/json' \
#     -d '{"jsonrpc":"2.0","id":1,"method":"eth_getCode","params":["<address>","latest"]}'
# must return bytecode, not "0x". Leave empty if unsure.
MULTICALL3_ADDRESS=

# --- Log-scan bounds (chain/holders.ts) ---
# A holder count is computed by replaying every Transfer log for a token
# from its launch block — real and exact, but confirmed against live
# Robinhood Chain mainnet to fail outright for an old token in one shot
# (~237,000 blocks in a single eth_getLogs call was rejected).
# Max block range per single eth_getLogs call.
LOG_SCAN_CHUNK_BLOCKS=2000
# How far back a holder scan will ever look, even for an old token — past
# this, the count is an honest bounded-window figure, not "lifetime".
MAX_HOLDER_SCAN_BLOCKS=20000
# First-time lifetime backfill from a token's launch block (then holders and
# trades are updated incrementally, block by block). Robinhood Chain makes
# ~14,000 blocks/hour, so 400000 ≈ 28h. Older tokens fall back to the bounded
# window above and are never labelled lifetime.
MAX_HOLDER_BACKFILL_BLOCKS=400000

# --- API rate limiting (api/server.ts) ---
# Per-IP, applies to /api/* only (never the static dashboard). Defaults
# are generous enough that normal local usage never hits them — this
# exists so the API can't be driven into unbounded RPC load if it's ever
# reachable from outside localhost.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
# Stricter per-IP cap on POST /api/chat only — each message can cost an LLM call
# on the server's key. The brief and summaries are cached, so they don't need this.
CHAT_RATE_LIMIT_WINDOW_MS=900000
CHAT_RATE_LIMIT_MAX=20

# --- Optional: AI layer (src/ai/) ---
# Unset by default. Without a key, GET /api/tokens/:address?summary=ai
# just omits naturalLanguageSummary, and POST /api/chat replies with a
# plain "not configured" message — nothing breaks, nothing is faked.
# The AI never sees raw chain data: it only ever rephrases numbers
# FLETCH's deterministic engine already computed (src/ai/explain.ts), or
# calls the same real functions the rest of the API uses as tools
# (src/ai/chatAgent.ts) — see docs/AI.md.
ANTHROPIC_API_KEY=
# Check https://docs.claude.com for the current model catalog before
# changing this — model names are periodically retired.
ANTHROPIC_MODEL=claude-sonnet-5

