{
  "name": "fletch",
  "version": "0.1.0",
  "description": "Meme intelligence for Robinhood Chain — real onchain signals, an explainable score, and no fabricated data.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/leopardracer/FLETCH#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/leopardracer/FLETCH.git"
  },
  "bugs": {
    "url": "https://github.com/leopardracer/FLETCH/issues"
  },
  "keywords": [
    "robinhood-chain",
    "meme-tokens",
    "onchain-intelligence",
    "pons-v2",
    "risk-analysis",
    "typescript"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json && node dist/index.js",
    "start": "node dist/index.js",
    "test": "tsc -p tsconfig.json && node --test dist/**/*.test.js",
    "test:watch": "tsc -p tsconfig.json && node --test --watch dist/**/*.test.js",
    "test:coverage": "tsc -p tsconfig.json && node --test --experimental-test-coverage --test-coverage-exclude=\"**/*.test.js\" dist/**/*.test.js",
    "test:integration": "tsc -p tsconfig.json && node --test dist/signals/signalService.test.js dist/radar/radarService.test.js dist/monitoring/monitoringService.test.js dist/monitoring/monitoringService.stress.test.js dist/api/server.test.js",
    "lint": "eslint src",
    "screenshot": "node scripts/screenshot.mjs"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "viem": "^2.21.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^26.6.1",
    "eslint": "^10.11.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.70.1"
  },
  "engines": {
    "node": ">=22.6.0"
  }
}
